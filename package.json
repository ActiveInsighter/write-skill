{
  "name": "write-skill",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "npx --yes wrangler@4 dev --config wrangler.jsonc",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "cf:prepare": "node scripts/prepare-cloudflare.mjs",
    "db:migrate:local": "npx --yes wrangler@4 d1 migrations apply write-skill-db --local --config wrangler.jsonc",
    "db:migrate:remote": "npx --yes wrangler@4 d1 migrations apply write-skill-db --remote --config wrangler.jsonc",
    "deploy": "npx --yes wrangler@4 deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@headless-tree/core": "^1.7.0",
    "@headless-tree/react": "^1.7.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-highlight": "^3.29.2",
    "@tiptap/extension-horizontal-rule": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-list": "^3.29.2",
    "@tiptap/extension-subscript": "^3.29.2",
    "@tiptap/extension-superscript": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/extension-typography": "^3.29.2",
    "@tiptap/extensions": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "clsx": "^2.1.1",
    "lodash.throttle": "^4.1.1",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hotkeys-hook": "^5.3.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "class-variance-authority": "^0.7.1",
    "sass-embedded": "^1.100.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  }
}
